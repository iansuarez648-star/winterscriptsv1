local lM1=0; local lSK=0; local sI=1; local sB=false
RunService.Heartbeat:Connect(function()
    if not CFG.Fly.Enabled then return end
    local mH=getHRP(LP); if not mH then return end
    local t=getFly(); if not t or not isAlive(t) then return end
    local eH=getHRP(t); if not eH then return end
    if (eH.Position-mH.Position).Magnitude>CFG.Fly.StopRange+3 then return end
    equipStyle(); local now=tick()
    if (now-lM1)>=CFG.Fly.M1Delay then lM1=now; task.spawn(doM1) end
    if CFG.Fly.UseSkills and not sB and (now-lSK)>=CFG.Fly.SkillDelay then
        lSK=now; sB=true; local s=CFG.Fly.SkillKeys[sI]; sI=(sI%#CFG.Fly.SkillKeys)+1
        task.spawn(function() doSK(s); task.wait(0.5); sB=false end)
    end
end)

local lAura=0
RunService.Heartbeat:Connect(function()
