local function nukeBV()
    if activeBV then pcall(function() activeBV:Destroy() end); activeBV=nil end
end

local function getBV()
    local h=getHRP(LP); if not h then return nil end
    if activeBV and activeBV.Parent==h then return activeBV end
    nukeBV()
    local bv=Instance.new("BodyVelocity"); bv.Name="_WSFly"
    bv.MaxForce=Vector3.new(1e6,1e6,1e6); bv.Velocity=Vector3.zero
    bv.Parent=h; activeBV=bv; return bv
end

LP.CharacterRemoving:Connect(nukeBV)

local function nc(on)
    local c=getChar(LP); if not c then return end
    for _,p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide=not on end
    end
end

RunService.Stepped:Connect(function() if CFG.Fly.Enabled then nc(true) end end)

RunService.Heartbeat:Connect(function()
    if not CFG.Fly.Enabled then
        if activeBV then
            activeBV.Velocity=Vector3.zero; nukeBV()
            local h=getHum(LP); if h then h:ChangeState(Enum.HumanoidStateType.GettingUp) end
            nc(false)
        end; return
    end
    local mH=getHRP(LP); local hum=getHum(LP); if not mH or not hum then return end
    local t=getFly(); local eH=t and getHRP(t)
    hum:ChangeState(Enum.HumanoidStateType.Physics); nc(true)
    if not eH then local bv=getBV(); if bv then bv.Velocity=Vector3.zero end; return end
    local dist=(eH.Position-mH.Position).Magnitude
    if dist<=CFG.Fly.StopRange then
        local bv=getBV(); if bv then bv.Velocity=Vector3.zero end
        mH.CFrame=CFrame.new(mH.Position,Vector3.new(eH.Position.X,mH.Position.Y,eH.Position.Z)); return
    end
    local bv=getBV(); if not bv then return end
    local tp=dist>CFG.Fly.DiveRange
        and eH.Position+Vector3.new(0,CFG.Fly.HoverHeight,0) or eH.Position
    bv.Velocity=bv.Velocity:Lerp((tp-mH.Position).Unit*CFG.Fly.Speed,CFG.Fly.Smooth)
    mH.CFrame=CFrame.new(mH.Position,Vector3.new(eH.Position.X,mH.Position.Y,eH.Position.Z))
end)

