local function bESP(player)
    if espD[player] then return end
    local data={}
    local sb=Instance.new("SelectionBox")
    sb.LineThickness=0.04; sb.SurfaceTransparency=CFG.ESP.T; sb.Parent=game.CoreGui; data.sb=sb
    local bb=Instance.new("BillboardGui")
    bb.AlwaysOnTop=true; bb.Size=UDim2.new(0,110,0,30)
    bb.StudsOffset=Vector3.new(0,4,0); bb.Parent=game.CoreGui; data.bb=bb
    local nl=Instance.new("TextLabel",bb)
    nl.Size=UDim2.new(1,0,0.52,0); nl.BackgroundTransparency=1
    nl.TextStrokeTransparency=0; nl.Font=Enum.Font.GothamBold; nl.TextScaled=true
    nl.Text=player.Name; data.nl=nl
    local bg=Instance.new("Frame",bb)
    bg.Size=UDim2.new(1,0,0.16,0); bg.Position=UDim2.new(0,0,0.56,0)
    bg.BackgroundColor3=Color3.fromRGB(8,8,8); bg.BorderSizePixel=0
    Instance.new("UICorner",bg).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame",bg)
    fill.Size=UDim2.new(1,0,1,0); fill.BackgroundColor3=CFG.ESP.BarOn
    fill.BorderSizePixel=0; Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    data.fill=fill
    local dl=Instance.new("TextLabel",bb)
    dl.Size=UDim2.new(1,0,0.28,0); dl.Position=UDim2.new(0,0,0.72,0)
    dl.BackgroundTransparency=1; dl.TextStrokeTransparency=0.3
    dl.Font=Enum.Font.Gotham; dl.TextScaled=true; data.dl=dl
    local function chams(char)
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then pcall(function()
                p.Material=Enum.Material.Neon; p.Transparency=CFG.ESP.T
            end) end
        end
    end
    local function wire(char)
        task.wait(0.8); local h=char:FindFirstChild("HumanoidRootPart"); if not h then return end
        sb.Adornee=char; bb.Adornee=h; chams(char)
    end
    if player.Character then task.spawn(wire,player.Character) end
    player.CharacterAdded:Connect(wire); espD[player]=data
    RunService.Heartbeat:Connect(function()
        if not espD[player] then return end
        local h=getHRP(player); local hum=getHum(player); local mH=getHRP(LP)
        if h and hum and hum.Health>0 and mH then
            local d=math.floor((h.Position-mH.Position).Magnitude)
            local hp=math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            local isTgt=(manualTarget==player or flyTarget==player or lockedTarget==player)
            local col=isTgt and P.iBri or (d<20 and P.red or (d<60 and P.amb or P.grn))
            bb.Adornee=h; sb.Adornee=player.Character
            data.fill.Size=UDim2.new(hp,0,1,0)
            data.fill.BackgroundColor3=hp>0.5 and CFG.ESP.BarOn or CFG.ESP.BarOff
            data.dl.Text=d.."s"; data.dl.TextColor3=col
            data.nl.TextColor3=col; sb.Color3=col; sb.SurfaceColor3=col
        else bb.Adornee=nil; sb.Adornee=nil end
    end)
end

local function dESP(p)
    local d=espD[p]; if not d then return end
    pcall(function() d.sb:Destroy() end); pcall(function() d.bb:Destroy() end); espD[p]=nil
end

