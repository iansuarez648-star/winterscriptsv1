local STYLES={"godhuman","superhuman","dragon","death step","electric","dark step",
    "water kung fu","sharkman","electric claw","soru soru","ice","fire","light","magma",
    "sand","smoke","string","rumble","phoenix","buddha","love","paw","gravity","dough",
    "shadow","venom","soul","mammoth","t-rex","leopard","gas","fighting style"}

local function isStyle(t)
    if t:FindFirstChildOfClass("RemoteEvent") then return true end
    local n=t.Name:lower()
    for _,s in ipairs(STYLES) do if n:find(s) then return true end end
end

local function equipStyle()
    local char=getChar(LP); local hum=getHum(LP); if not char or not hum then return end
    for _,o in ipairs(char:GetChildren()) do if o:IsA("Tool") and isStyle(o) then return end end
    local bp=LP:FindFirstChildOfClass("Backpack"); if not bp then return end
    for _,t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and isStyle(t) then hum:EquipTool(t); task.wait(0.25); return end
    end
end

local V4N={"race v4","racv4","v4","awakening","race awakening","fourth"}
local V4R={"RaceV4","V4Activate","V4","Awakening","ActivateRace","RaceAbility","AwakenRace"}
local function isV4(n) n=n:lower(); for _,v in ipairs(V4N) do if n:find(v) then return true end end end

local function fireV4()
    local char=getChar(LP); local hum=getHum(LP)
    if char then for _,o in ipairs(char:GetChildren()) do if o:IsA("Tool") and isV4(o.Name) then
        local r=o:FindFirstChildOfClass("RemoteEvent")
        if r then pcall(function() r:FireServer() end) else pcall(function() o:Activate() end) end
        v4Active=true; return
    end end end
    local bp=LP:FindFirstChildOfClass("Backpack")
    if bp and hum then for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") and isV4(t.Name) then
        hum:EquipTool(t); task.wait(0.3)
        local r=t:FindFirstChildOfClass("RemoteEvent")
        if r then pcall(function() r:FireServer() end) else pcall(function() t:Activate() end) end
        v4Active=true; return
    end end end
    for _,rn in ipairs(V4R) do
        local r=game.ReplicatedStorage:FindFirstChild(rn,true)
        if r then
            if r:IsA("RemoteEvent") then pcall(function() r:FireServer() end)
            else pcall(function() r:InvokeServer() end) end
            v4Active=true; return
        end
    end
    pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.J,false,game) end); task.wait(0.08)
    pcall(function() VIM:SendKeyEvent(false,Enum.KeyCode.J,false,game) end); v4Active=true
end

local function isV4BarFull()
    local pg=LP:FindFirstChild("PlayerGui"); if not pg then return false end
    local kw={"race","v4","awaken","fourth","gauge","charge","bar","fill"}
    for _,obj in ipairs(pg:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("ImageLabel") then
            local n=obj.Name:lower()
            for _,k in ipairs(kw) do
                if n:find(k) then
                    if obj.Size.X.Scale>=0.95 then return true end
                    local par=obj.Parent
                    if par and par:IsA("GuiObject") and par.AbsoluteSize.X>0 then
                        if (obj.AbsoluteSize.X/par.AbsoluteSize.X)>=0.95 then return true end
                    end
                end
            end
        end
    end
    return false
end

local function v4Loop()
    v4Active=false
    while CFG.V4.Enabled do
        task.wait(0.3)
        if not CFG.V4.Enabled then break end
        if isV4BarFull() then fireV4(); task.wait(2) end
    end
    v4Active=false
end

