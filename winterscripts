local function getChar(p)  return p and p.Character end
local function getHRP(p)   local c=getChar(p); return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p)   local c=getChar(p); return c and c:FindFirstChildOfClass("Humanoid") end
local function isAlive(p)  local h=getHum(p);  return h and h.Health>0 end

local function enemies()
    local t={}; local mH=getHRP(LP)
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP and isAlive(p) then
            local h=getHRP(p)
            if h then table.insert(t,{p=p,d=mH and (h.Position-mH.Position).Magnitude or 9999}) end
        end
    end
    table.sort(t,function(a,b) return a.d<b.d end)
    return t
end

local function furthest() local t=enemies(); return #t>0 and t[#t].p or nil end
local function getFly()   return (manualTarget and isAlive(manualTarget) and manualTarget) or flyTarget end
local function getLock()  return (manualTarget and isAlive(manualTarget) and manualTarget) or lockedTarget end

